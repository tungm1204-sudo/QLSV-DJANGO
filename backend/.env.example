# =============================================================================
# .env.example — Template biến môi trường cho dự án QLSV-DJANGO
# =============================================================================
# HƯỚNG DẪN CHO DEV MỚI:
#   1. Copy file này: cp .env.example .env
#   2. Điền các giá trị thật vào file .env vừa tạo
#   3. TUYỆT ĐỐI không commit file .env lên Git (đã có trong .gitignore)
# =============================================================================

# --- SETTINGS MODULE ---
# Development (máy local):   config.settings.development
# Production (server thật):  config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.development

# --- DATABASE ---
# Chuỗi kết nối đến PostgreSQL (Neon hoặc bất kỳ Postgres nào).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# Xin thông tin kết nối từ Team Lead.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# --- DJANGO SECRET KEY ---
# Dùng để ký JWT token, session, CSRF.
# Để tạo key mới, chạy lệnh trong terminal:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Lý do: Mỗi môi trường phải có SECRET_KEY riêng để đảm bảo bảo mật.
SECRET_KEY=your-secret-key-here

# --- DEBUG MODE ---
# Development: True (hiển thị lỗi chi tiết)
# Production:  False (ẨN lỗi, không để lộ thông tin hệ thống)
DEBUG=True

# =============================================================================
# CHỈ CẦN THIẾT CHO PRODUCTION (bỏ qua nếu đang dev local)
# =============================================================================

# Danh sách domain được phép, cách nhau bởi dấu phẩy.
# Ví dụ: yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=

# Danh sách origin Frontend được phép gọi API, cách nhau bởi dấu phẩy.
# Ví dụ: https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_ORIGINS=
