# =============================================================================
# .env.example — Template biến môi trường cho dự án QLSV-DJANGO
# =============================================================================
# HƯỚNG DẪN CHO DEV MỚI:
#   1. Copy file này: cp .env.example .env
#   2. Điền các giá trị thật vào file .env vừa tạo
#   3. TUYỆT ĐỐI không commit file .env lên Git (đã có trong .gitignore)
# =============================================================================

# --- SETTINGS MODULE ---
# Development (máy local):   config.settings.development
# Production (server thật):  config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.development

# --- DATABASE ---
# Chuỗi kết nối đến PostgreSQL (Neon).
# Cách lấy: Vào https://console.neon.tech → Chọn project → Tab "Connection Details"
#            → Copy chuỗi "Connection string" dán vào đây.
# Lưu ý: Cả team dùng CHUNG 1 database Neon, nên connection string là như nhau.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# --- DJANGO SECRET KEY ---
# Dùng để ký JWT token, session, CSRF.
# Cả team dùng CHUNG 1 SECRET_KEY để token của nhau không bị lỗi khi test chéo.
# Xem giá trị SECRET_KEY trong Neon dashboard hoặc hỏi Team Lead.
# Để tạo key mới (chỉ dùng khi cần thiết):
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# --- DEBUG MODE ---
# Development: True (hiển thị lỗi chi tiết)
# Production:  False (ẨN lỗi, không để lộ thông tin hệ thống)
DEBUG=True

# =============================================================================
# CHỈ CẦN THIẾT CHO PRODUCTION (bỏ qua nếu đang dev local)
# =============================================================================

# Danh sách domain được phép, cách nhau bởi dấu phẩy.
# Ví dụ: yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=

# Danh sách origin Frontend được phép gọi API, cách nhau bởi dấu phẩy.
# Ví dụ: https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_ORIGINS=
